# Identidad del stack
COMPOSE_PROJECT_NAME=coferlandia-ci

# Almacenamiento limitado creado por scripts/install-host.sh
CI_STORAGE_ROOT=/srv/coferlandia-ci
CI_STORAGE_IMAGE=/var/lib/coferlandia-ci.img
CI_STORAGE_SIZE=30G

# Registro de los dos runners
RUNNER_URL=https://github.com/coferlandia
RUNNER_01_NAME=coferlandia-ci-01
RUNNER_02_NAME=coferlandia-ci-02
RUNNER_LABELS=coferlandia-ci,docker
RUNNER_GROUP=Default
RUNNER_WORKDIR=_work

# Imágenes. Se actualizan deliberadamente con scripts/update.sh
RUNNER_IMAGE_TAG=latest
DIND_IMAGE_TAG=29-dind
COMPOSE_VERSION=v5.1.4

# Límites por contenedor runner. Cada listener ejecuta como máximo un job.
RUNNER_CPUS=0.50
RUNNER_MEMORY=3g
RUNNER_MEMORY_RESERVATION=512m
RUNNER_PIDS_LIMIT=256

# Límites por daemon Docker exclusivo. Hay uno por runner.
DIND_CPUS=1.25
DIND_MEMORY=2500m
DIND_MEMORY_RESERVATION=512m
DIND_PIDS_LIMIT=768
DIND_SHM_SIZE=384m

# Política de limpieza
DISK_WARN_PERCENT=75
DISK_AGGRESSIVE_PERCENT=82
DISK_EMERGENCY_PERCENT=90
DISK_RECOVERY_PERCENT=70
HOST_DISK_WARN_PERCENT=85
HOST_DISK_EMERGENCY_PERCENT=92
IMAGE_RETENTION_HOURS=168
PACKAGE_CACHE_RETENTION_DAYS=30
WORKSPACE_RETENTION_DAYS=7
BUILDKIT_CACHE_KEEP=4GB
BUILDKIT_CACHE_EMERGENCY_KEEP=1GB

# Logs Docker del stack exterior
RUNNER_LOG_MAX_SIZE=10m
RUNNER_LOG_MAX_FILES=3
DIND_LOG_MAX_SIZE=20m
DIND_LOG_MAX_FILES=3
