# Copiar como /etc/coferlandia-ci-watchdog.env y proteger con chmod 600.

# Telegram. Dejar vacío para registrar problemas solamente en journald.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Consulta opcional del estado remoto de ambos runners en GitHub.
# Valores admitidos para GITHUB_SCOPE_TYPE: org o repo.
GITHUB_MONITOR_TOKEN=
GITHUB_SCOPE_TYPE=org
GITHUB_OWNER=coferlandia
GITHUB_REPOSITORY=
GITHUB_API_VERSION=2026-03-10

# Los nombres se toman de RUNNER_01_NAME y RUNNER_02_NAME en .env.

# Repetir una alerta sin cambios después de este intervalo.
ALERT_REPEAT_SECONDS=3600
